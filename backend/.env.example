# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to Git.

# Quick start without Atlas: set USE_MEMORY_DB=true (data is lost on restart)
USE_MEMORY_DB=false

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai_smart_healthcare

# Long random secret used to sign login tokens (at least 32 characters).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<paste-a-long-random-secret-here>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Comma-separated list of allowed web origins (not needed for the Android app)
CORS_ORIGINS=http://localhost:3000

# AI providers (used from Phase D onwards — keys stay on the backend only)
GEMINI_API_KEY=<your-gemini-key>
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=<your-groq-key>
GROQ_MODEL=llama-3.3-70b-versatile
XAI_API_KEY=
# Which provider to try first, and which to use if it fails (gemini | groq)
AI_PRIMARY=gemini
AI_FALLBACK=groq
